# Copy to server/.env (optional — every value has a development default).
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/campusflow
# Browser origins allowed to call the API with cookies (comma-separated).
WEB_ORIGIN=http://localhost:5173
# HMAC key that signs ticket QR payloads. REQUIRED in production (32+ random characters).
TICKET_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
SESSION_TTL_DAYS=14
# Defaults to true in production. Set false only for plain-HTTP local testing.
# COOKIE_SECURE=false
# Number of reverse proxies in front of the API (for correct client IPs in rate limits).
TRUST_PROXY=0
UPLOAD_DIR=uploads
# Serve the built web app from the API process (production single-process mode).
# WEB_DIST=../web/dist
LOG_LEVEL=info
